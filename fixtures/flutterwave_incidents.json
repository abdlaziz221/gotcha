        {
          "id": "0z7r27mw2grs",
          "status": "identified",
          "body": "Dear Valued Merchant,\n\nKES payouts have been restored and are processing normally.\n\nWe apologize for the disruption and appreciate your patience and understanding.",
          "incident_id": "25rf98nhjkt3",
          "created_at": "2026-10-14T10:47:51.935Z",
          "updated_at": "2026-10-14T10:47:51.935Z",
          "display_at": "2026-10-14T10:47:51.935Z",
          "affected_components": [
