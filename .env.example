# Copier en .env (jamais commité) ou définir ces variables sur Datacloud.
# Toutes sont facultatives en développement : les valeurs par défaut suffisent.

# dev | test | prod. En prod : brouillons cachés, flux de pannes en direct, PostgreSQL.
GOTCHA_ENV=dev

# memory (fichiers de content/ et fixtures/, aucune base à installer) | postgres
GOTCHA_STORE=memory
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/gotcha

# Afficher les fiches et pièges en brouillon (interdit en prod).
# GOTCHA_SHOW_DRAFTS=true
# Charger les pannes et contributions fictives de fixtures/ (stockage memory).
# GOTCHA_LOAD_FIXTURES=true
# Lire le vrai flux Flutterwave (sinon l'extrait enregistré dans fixtures/).
# GOTCHA_INGEST_LIVE=false
# GOTCHA_INGEST_MIN_INTERVAL_MINUTES=10

# Relecteurs : pseudo:empreinte;pseudo2:empreinte2 (python scripts/hash_password.py <pseudo>)
# GOTCHA_REVIEWERS=

# Adresse publique du site (liens renvoyés aux agents par le serveur MCP).
# GOTCHA_SITE_URL=https://gotcha.example
# En-têtes Host acceptés par le serveur MCP, séparés par des virgules.
# GOTCHA_ALLOWED_HOSTS=gotcha.example
# Nombre de proxys de confiance devant le site (1 par défaut en prod, 0 sinon). L'adresse du
# visiteur est la valeur ajoutée par le dernier d'entre eux dans X-Forwarded-For.
# GOTCHA_PROXY_HOPS=1
# Sonde des limites de l'hébergeur (/_sonde/…, scripts/probe_platform.py), le temps des mesures.
# GOTCHA_PROBE=false

# Connexion GitHub obligatoire pour le serveur MCP (vrai par défaut en prod, faux sinon).
# Elle demande les deux valeurs ci-dessous, une application OAuth GitHub dont l'adresse de
# retour est <GOTCHA_SITE_URL>/github/callback, et PostgreSQL en production.
# Valeur false en prod : serveur MCP en lecture libre, sans aucun outil d'écriture.
# GOTCHA_MCP_AUTH=true
# GOTCHA_GITHUB_CLIENT_ID=
# GOTCHA_GITHUB_CLIENT_SECRET=

# Tests de contrat PostgreSQL : base JETABLE, vidée à chaque test.
# GOTCHA_TEST_DATABASE_URL=postgresql://localhost:5432/gotcha_test
